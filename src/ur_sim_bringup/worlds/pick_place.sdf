<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place">
    <physics name="fine" type="dart"><max_step_size>0.002</max_step_size></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <direction>-0.3 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="table">
      <static>true</static>
      <pose>0.6 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.8 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.8 0.2</size></box></geometry>
          <material><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Zone pads: visual only (no collision), 0.20 x 0.20 m. Centres must match ZONE_CENTERS in agent.py.
         Colours are yellow / light grey so the red/green/blue detector ignores them. -->
    <model name="zone_left">
      <static>true</static>
      <pose>0.55 0.28 0.2005 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.2 0.2 0.001</size></box></geometry>
          <material><diffuse>0.9 0.8 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="zone_right">
      <static>true</static>
      <pose>0.55 -0.28 0.2005 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.2 0.2 0.001</size></box></geometry>
          <material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_cube">
      <pose>0.5 0.1 0.225 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <velocity_decay><linear>1.0</linear><angular>1.0</angular></velocity_decay>
        <inertial><mass>0.1</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>4e-5</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_cube">
      <pose>0.6 -0.15 0.225 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <velocity_decay><linear>1.0</linear><angular>1.0</angular></velocity_decay>
        <inertial><mass>0.1</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>4e-5</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><diffuse>0 0 1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_cube">
      <pose>0.7 0.12 0.225 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <velocity_decay><linear>1.0</linear><angular>1.0</angular></velocity_decay>
        <inertial><mass>0.1</mass><inertia><ixx>4e-5</ixx><iyy>4e-5</iyy><izz>4e-5</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface></collision>
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="overhead_cam">
      <static>true</static>
      <pose>0.6 0 1.2 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="rgbd" type="rgbd_camera">
          <update_rate>10</update_rate>
          <topic>overhead</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>3.0</far></clip>
          </camera>
          <always_on>1</always_on>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
